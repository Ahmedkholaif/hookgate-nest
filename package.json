{
  "name": "hookgate-nest",
  "version": "1.0.0",
  "description": "Webhook ingestion and processing in NestJS: RabbitMQ / SQS / Pub/Sub, outbox, dedup, idempotent consumers. Same contract and schema as hookgate (Go)",
  "type": "module",
  "private": true,
  "license": "MIT",
  "scripts": {
    "build": "rm -rf dist && tsc && cp -r src/database/migrations dist/database/",
    "start": "node dist/main.js",
    "test": "npm run build && node --test --test-concurrency=1 \"dist/**/*.test.js\""
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3.1149.0",
    "@google-cloud/pubsub": "^6.2.0",
    "@nestjs/common": "^12.1.3",
    "@nestjs/core": "^12.1.3",
    "@nestjs/platform-express": "^12.1.3",
    "amqplib": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.15.1",
    "pg": "^8.23.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.5",
    "@types/pg": "^8.23.1",
    "typescript": "^6.0.3"
  }
}
